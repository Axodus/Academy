{
  "name": "@axodus/academy-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:api": "tsx watch src/index.ts",
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch src/index.ts\"",
    "build:web": "vite build",
    "build:api": "tsc -p tsconfig.json",
    "build": "run-s build:web build:api",
    "preview": "vite preview",
    "hh": "hardhat",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:ethereum": "hardhat run scripts/deploy.ts --network ethereum",
    "deploy:arbitrum": "hardhat run scripts/deploy.ts --network arbitrum",
    "deploy:bnb": "hardhat run scripts/deploy.ts --network bnb",
    "deploy:opbnb": "hardhat run scripts/deploy.ts --network opbnb",
    "deploy:harmony": "hardhat run scripts/deploy.ts --network harmony",
    "deploy:solana": "tsx scripts/deploy-solana.ts",
    "deploy:greenfield": "tsx scripts/deploy-greenfield.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/jwt": "^10.0.0",
    "@reown/appkit": "^1.8.2",
    "@reown/appkit-adapter-ethers": "^1.8.2",
    "@reown/appkit-adapter-solana": "^1.8.2",
    "@solana/web3.js": "^1.95.0",
    "@tanstack/react-query": "^5.100.10",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/prop-types": "^15.7.15",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.11.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.2.2",
    "ethers": "^6.15.0",
    "fastify": "^5.6.0",
    "hardhat": "^3.0.4",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "ms": "^2.1.3",
    "pino": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "tweetnacl": "^1.0.3",
    "vite": "^5.4.21",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.10.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
